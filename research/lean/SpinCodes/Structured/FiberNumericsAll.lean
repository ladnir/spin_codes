theorem fiber_caps_frozen (j : Fin 129) {q : Finset (Fin 19)} (hq : q ≠ ∅) :
    (ConcreteMaps.syndromeFiber j q).card ≤ (SparsePolynomial.weightN j).cap := by
  rw [cap_frozen_eq]
  exact fiber_caps hs j hq
end Spin.Structured.FiberNumerics
