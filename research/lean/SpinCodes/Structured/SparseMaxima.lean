theorem maximum_0 (x : ℝ) (h0 : 0 ≤ x) (h1 : x ≤ 1) :
    Spin.Imt.Occupation.Sparse.maximumMoment 0 (1 - x / 6250) ≤
      (arbitrary 0 Data.weight0).eval x := by
  have hs : (arbitrary 0 Data.weight0).eval x = Dominance0.m0.eval x := by
    change (moment 48 0).eval x = _
    exact RatPoly.checkEq_sound _ _ Dominance0.m0_checked x
  apply maximumMoment_le_polynomial 0 x h1 (arbitrary 0 Data.weight0)
  · exact (RatPoly.checkEq_sound _ _ Dominance0.m0_checked x).le.trans
      ((RatPoly.checkLE_sound _ _ Dominance0.m0_le_checked h0 h1).trans_eq hs.symm)
  · exact (RatPoly.checkEq_sound _ _ Dominance0.m1_checked x).le.trans
      ((RatPoly.checkLE_sound _ _ Dominance0.m1_le_checked h0 h1).trans_eq hs.symm)
  · exact (RatPoly.checkEq_sound _ _ Dominance0.m2_checked x).le.trans
      ((RatPoly.checkLE_sound _ _ Dominance0.m2_le_checked h0 h1).trans_eq hs.symm)
  · exact (RatPoly.checkEq_sound _ _ Dominance0.m3_checked x).le.trans
      ((RatPoly.checkLE_sound _ _ Dominance0.m3_le_checked h0 h1).trans_eq hs.symm)
  · exact (RatPoly.checkEq_sound _ _ Dominance0.m4_checked x).le.trans
      ((RatPoly.checkLE_sound _ _ Dominance0.m4_le_checked h0 h1).trans_eq hs.symm)
