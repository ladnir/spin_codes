def w4 : Fix := ⟨2000000000000000000000000000, 53000000000000000000000000000⟩

theorem logs4_ok : (table4).check terms = true := by decide

theorem tree4_ok :
    checkTree (leafOK (treeLog table4) thr) tree4 a4 b4 w4 = true := by decide

theorem part4_claim (x y z : ℝ) (hx : Mem a4 x)
    (hy : Mem b4 y) (hz : Mem w4 z) :
    DenseClaim thr x y z :=
  denseTail_of_checkTree (treeLog_oracle logs4_ok) tree4 tree4_ok hx hy hz

end Spin.Cover
