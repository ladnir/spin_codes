import SpinCodes.Turbo.SparseSpectrumInteger22

/-! Exact integer RS8 expected packet counts. A computable list mirror of
polynomial arithmetic is proved homomorphic once; the 65 coefficients are
then fixed by one small kernel decision. -/
noncomputable section
namespace Spin.Turbo
open Polynomial

namespace RS8CountList22

def lAdd : List ℤ → List ℤ → List ℤ
  | [], q => q
  | a :: p, [] => a :: p
  | a :: p, b :: q => (a + b) :: lAdd p q

def lMul : List ℤ → List ℤ → List ℤ
  | [], _ => []
  | x :: a, b => lAdd (b.map (x * ·)) (0 :: lMul a b)

def lPow (a : List ℤ) : ℕ → List ℤ
  | 0 => [1]
  | n + 1 => lMul (lPow a n) a

def toPoly : List ℤ → Polynomial ℤ
  | [] => 0
  | a :: l => C a + X * toPoly l

theorem toPoly_add : ∀ p q, toPoly (lAdd p q) = toPoly p + toPoly q
  | [], q => by simp [lAdd, toPoly]
  | a :: p, [] => by simp [lAdd, toPoly]
  | a :: p, b :: q => by
    simp only [lAdd, toPoly, toPoly_add p q, C_add]
    ring

theorem toPoly_map (x : ℤ) : ∀ b, toPoly (b.map (x * ·)) = C x * toPoly b
  | [] => by simp [toPoly]
  | b :: l => by
    simp only [List.map_cons, toPoly, toPoly_map x l, C_mul]
    ring

theorem toPoly_mul : ∀ a b, toPoly (lMul a b) = toPoly a * toPoly b
  | [], b => by simp [lMul, toPoly]
  | x :: a, b => by
    simp only [lMul, toPoly_add, toPoly_map, toPoly, C_0, zero_add, toPoly_mul a b]
    ring

theorem toPoly_pow (a : List ℤ) : ∀ n, toPoly (lPow a n) = toPoly a ^ n
  | 0 => by simp [lPow, toPoly]
  | n + 1 => by rw [lPow, toPoly_mul, toPoly_pow a n, pow_succ]

theorem coeff_toPoly : ∀ (l : List ℤ) (n : ℕ), (toPoly l).coeff n = l.getD n 0
  | [], n => by simp [toPoly]
  | a :: l, 0 => by simp [toPoly]
  | a :: l, n + 1 => by
    simp only [toPoly, coeff_add, coeff_C, coeff_X_mul, coeff_toPoly l n, List.getD_cons_succ,
      Nat.succ_ne_zero, if_false, zero_add]

def qList : List ℤ := lAdd (lPow [1, 15] 8) [-1]

theorem qList_eq : toPoly qList = (1 + 15 * X) ^ 8 - 1 := by
  have h15 : toPoly [1, 15] = 1 + 15 * X := by
    simp only [toPoly, mul_zero, add_zero, C_1]
    rw [show (C (15 : ℤ) : Polynomial ℤ) = 15 from by simp]
    ring
  have hm1 : toPoly [-1] = -1 := by simp [toPoly]
  rw [qList, toPoly_add, toPoly_pow, h15, hm1]
  ring

def coefA (h : ℕ) : ℤ :=
  match h with
  | 5 => 19055812529825445556951872403029511635000
  | 6 => 9527906256039168583076436398361133711500
  | 7 => 2722258930296905310926149924741321851000
  | _ => 340282366287113163865768740506765885475

theorem coefA_eq (h : ℕ) (hh : h ∈ Finset.Icc 5 8) :
    sparseRS8A22 h * (4294967295 : ℤ) ^ (8 - h) = coefA h := by
  simp only [Finset.mem_Icc] at hh
  obtain ⟨h1, h2⟩ := hh
  interval_cases h <;> simp [sparseRS8A22, coefA, Finset.sum_range_succ, Nat.choose]

def countList : List ℤ :=
  lAdd ((lPow qList 5).map (coefA 5 * ·)) (lAdd ((lPow qList 6).map (coefA 6 * ·))
    (lAdd ((lPow qList 7).map (coefA 7 * ·)) ((lPow qList 8).map (coefA 8 * ·))))

theorem countList_eq : toPoly countList = sparseRS8IntegerPolynomial22 := by
  unfold sparseRS8IntegerPolynomial22
  rw [show (Finset.Icc 5 8 : Finset ℕ) = {5, 6, 7, 8} from by decide]
  simp only [Finset.sum_insert, Finset.mem_insert, Finset.mem_singleton, Finset.sum_singleton,
    show (5 : ℕ) ≠ 6 from by decide, show (5 : ℕ) ≠ 7 from by decide, show (5 : ℕ) ≠ 8 from by decide,
    show (6 : ℕ) ≠ 7 from by decide, show (6 : ℕ) ≠ 8 from by decide,
    show (7 : ℕ) ≠ 8 from by decide, or_self, not_false_eq_true]
  rw [coefA_eq 5 (by decide), coefA_eq 6 (by decide), coefA_eq 7 (by decide),
    coefA_eq 8 (by decide)]
  simp only [countList, toPoly_add, toPoly_map, toPoly_pow, qList_eq]

