theorem countList_lit : countList = countLit := by decide +kernel

theorem count_eq (points : Fin 8 → Field16) (hp : Function.Injective points) (v : ℕ) :
    rs8ExpectedPacketCount points v = (countLit.getD v 0 : ℝ) / (4294967295 : ℝ) ^ 8 := by
  rw [sparseRS8ExpectedPacketCount22_eq_integer_coeff points hp v, ← countList_eq,
    coeff_toPoly, countList_lit]

