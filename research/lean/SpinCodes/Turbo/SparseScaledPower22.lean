/-! Scaled (mantissa + binary exponent) lower power trace.

Generalizes the absolute-scale trace `SparseFixedSound22.powerCertificate_sound`:
for `z = zNum / 2^zBits` with `0 ≤ zNum`, a certificate gives a positive integer
mantissa `m` and an integer exponent `E` with `m * 2^(-E) ≤ z^d`, without ever
forming `zNum^d` and without a fixed absolute grid (so `z^d ≈ 2^-300000` is fine).

Trace semantics (MSB-first square-and-multiply). Each entry is
`(bit, shift, m')`. The state `(e, E, m)` starts at `(0, 0, 1)` and satisfies the
invariant `m ≤ z^e * 2^E` (equivalently `m * 2^(-E) ≤ z^e`). One step:

* `e' = 2e + [bit]`,
* `E' = 2E + [bit]*zBits - shift`,
* checked (integers only): `0 ≤ m`, `0 ≤ m'`,
  `m' * 2^shift ≤ m * m * (if bit then zNum else 1)`.

Soundness of a step: `m' * 2^shift ≤ m^2 * b ≤ (z^e 2^E)^2 * b`, and for
`bit = true`, `b = zNum = z * 2^zBits`, so the right side is
`z^(2e+1) * 2^(2E+zBits)`; dividing by `2^shift` gives the invariant for `(e', E', m')`.

Producer (rounding is downward, which is the sound direction):
`P := m*m*(if bit then zNum else 1)`, `shift := max 0 (bitlen P - 512)`,
`m' := P >>> shift` (floor). Then `m' ∈ [2^511, 2^512)` once `P ≥ 2^511`, so the
mantissa stays ~512 bits and the per-step relative loss is `< 2^-510`. The bits
are the binary digits of `d`, most significant first (leading bit is `1`).
`2^shift` is evaluated as a `Nat` power (GMP-accelerated in the kernel). -/

namespace Spin.Turbo

/-! ## Core-only definitions -/

/-- Exponent of `z` reached after the trace, starting from `e`. -/
def sparseScaledPowerDegAux22 : Nat → List (Bool × Nat × Int) → Nat
  | e, [] => e
  | e, (bit, _, _) :: tail => sparseScaledPowerDegAux22 (2 * e + if bit then 1 else 0) tail

/-- Binary exponent `E` after the trace, starting from `E`. -/
def sparseScaledPowerExpAux22 (zBits : Nat) : Int → List (Bool × Nat × Int) → Int
  | E, [] => E
  | E, (bit, shift, _) :: tail =>
    sparseScaledPowerExpAux22 zBits
      (2 * E + (if bit then (zBits : Int) else 0) - (shift : Int)) tail

/-- Last mantissa of the trace, starting from `m`. -/
def sparseScaledPowerMantAux22 : Int → List (Bool × Nat × Int) → Int
  | m, [] => m
  | _, (_, _, next) :: tail => sparseScaledPowerMantAux22 next tail

/-- Per-step integer checks, starting from mantissa `m`. -/
def sparseScaledPowerTraceCheck22 (zNum : Int) : Int → List (Bool × Nat × Int) → Bool
  | _, [] => true
  | m, (bit, shift, next) :: tail =>
    decide (0 ≤ m ∧ 0 ≤ next ∧
      next * ((2 ^ shift : Nat) : Int) ≤ m * m * (if bit then zNum else 1)) &&
    sparseScaledPowerTraceCheck22 zNum next tail

/-- Final binary exponent `E`. -/
def sparseScaledPowerExp22 (zBits : Nat) (trace : List (Bool × Nat × Int)) : Int :=
  sparseScaledPowerExpAux22 zBits 0 trace

/-- Final mantissa `m`. -/
def sparseScaledPowerMant22 (trace : List (Bool × Nat × Int)) : Int :=
  sparseScaledPowerMantAux22 1 trace

/-- Final exponent of `z` (must equal `d`). -/
def sparseScaledPowerDeg22 (trace : List (Bool × Nat × Int)) : Nat :=
  sparseScaledPowerDegAux22 0 trace

def sparseScaledPowerCheck22 (zNum : Int) (_zBits : Nat) (d : Nat)
    (trace : List (Bool × Nat × Int)) : Bool :=
  decide (0 ≤ zNum ∧ sparseScaledPowerDeg22 trace = d ∧
    0 < sparseScaledPowerMant22 trace) &&
  sparseScaledPowerTraceCheck22 zNum 1 trace

/-! ## Soundness -/

namespace SparseScaledPower22

private theorem two_ne : (2 : ℝ) ≠ 0 := two_ne_zero

private theorem scaled_trace_aux (zNum : ℤ) (zBits : ℕ) (hz : 0 ≤ zNum) :
    ∀ (trace : List (Bool × ℕ × ℤ)) (m : ℤ) (E : ℤ) (e : ℕ),
      (m : ℝ) ≤ ((zNum : ℝ) / 2 ^ zBits) ^ e * (2 : ℝ) ^ E →
      sparseScaledPowerTraceCheck22 zNum m trace = true →
      (sparseScaledPowerMantAux22 m trace : ℝ) ≤
        ((zNum : ℝ) / 2 ^ zBits) ^ (sparseScaledPowerDegAux22 e trace) *
          (2 : ℝ) ^ (sparseScaledPowerExpAux22 zBits E trace)
  | [], m, E, e, h, _ => by
    simpa [sparseScaledPowerMantAux22, sparseScaledPowerDegAux22,
      sparseScaledPowerExpAux22] using h
  | (bit, shift, next) :: tail, m, E, e, h, hc => by
    simp only [sparseScaledPowerTraceCheck22, Bool.and_eq_true, decide_eq_true_eq] at hc
    obtain ⟨⟨hm0, _, hstep⟩, hrest⟩ := hc
    simp only [sparseScaledPowerMantAux22, sparseScaledPowerDegAux22,
      sparseScaledPowerExpAux22]
    refine scaled_trace_aux zNum zBits hz tail next _ _ ?_ hrest
    set z : ℝ := (zNum : ℝ) / 2 ^ zBits with hzdef
    set A : ℝ := z ^ e * (2 : ℝ) ^ E with hA
    have hmR : (0 : ℝ) ≤ m := by exact_mod_cast hm0
    have hzR : (0 : ℝ) ≤ zNum := by exact_mod_cast hz
    have h2s : (0 : ℝ) < (2 : ℝ) ^ shift := pow_pos two_pos shift
    have h2b : (0 : ℝ) < (2 : ℝ) ^ zBits := pow_pos two_pos zBits
    have hmm : (m : ℝ) * m ≤ A * A := mul_self_le_mul_self hmR h
    have hEexp : (2 : ℝ) ^ (E + E) = (2 : ℝ) ^ E * (2 : ℝ) ^ E := zpow_add₀ two_ne E E
    cases bit
    · simp only [Bool.false_eq_true, ↓reduceIte] at hstep ⊢
      have hR : ((next * ((2 ^ shift : ℕ) : ℤ) : ℤ) : ℝ) ≤ ((m * m * 1 : ℤ) : ℝ) :=
        Int.cast_le.mpr hstep
      push_cast at hR
      have htarget : z ^ (2 * e + 0) * (2 : ℝ) ^ (2 * E + 0 - (shift : ℤ)) =
          A * A / (2 : ℝ) ^ shift := by
        rw [add_zero, add_zero, zpow_sub₀ two_ne, two_mul E, hEexp, zpow_natCast, hA,
          pow_mul]
        ring
      rw [htarget, le_div_iff₀ h2s]
      linarith
    · simp only [↓reduceIte] at hstep ⊢
      have hR : ((next * ((2 ^ shift : ℕ) : ℤ) : ℤ) : ℝ) ≤ ((m * m * zNum : ℤ) : ℝ) :=
        Int.cast_le.mpr hstep
      push_cast at hR
      have htarget : z ^ (2 * e + 1) * (2 : ℝ) ^ (2 * E + (zBits : ℤ) - (shift : ℤ)) =
          A * A * zNum / (2 : ℝ) ^ shift := by
        rw [zpow_sub₀ two_ne, zpow_add₀ two_ne, two_mul E, hEexp, zpow_natCast,
          zpow_natCast, hA, pow_succ, pow_mul, hzdef]
        field_simp
        ring
      rw [htarget, le_div_iff₀ h2s]
      calc (next : ℝ) * 2 ^ shift ≤ m * m * zNum := hR
        _ ≤ A * A * zNum := mul_le_mul_of_nonneg_right hmm hzR

/-- A passing scaled certificate gives a strictly positive mantissa `m` and an
exponent `E` with `m * 2^(-E) ≤ (zNum / 2^zBits)^d`. -/
theorem scaledPower_sound (zNum : ℤ) (zBits d : ℕ) (trace : List (Bool × ℕ × ℤ))
    (hcheck : sparseScaledPowerCheck22 zNum zBits d trace = true) :
    0 < sparseScaledPowerMant22 trace ∧
      (sparseScaledPowerMant22 trace : ℝ) * (2 : ℝ) ^ (-sparseScaledPowerExp22 zBits trace) ≤
        ((zNum : ℝ) / 2 ^ zBits) ^ d := by
  simp only [sparseScaledPowerCheck22, Bool.and_eq_true, decide_eq_true_eq] at hcheck
  obtain ⟨⟨hz, hdeg, hpos⟩, htr⟩ := hcheck
  refine ⟨hpos, ?_⟩
  have h := scaled_trace_aux zNum zBits hz trace 1 0 0 (by simp) htr
  rw [← hdeg]
  calc (sparseScaledPowerMant22 trace : ℝ) * (2 : ℝ) ^ (-sparseScaledPowerExp22 zBits trace)
      ≤ (((zNum : ℝ) / 2 ^ zBits) ^ (sparseScaledPowerDeg22 trace) *
          (2 : ℝ) ^ sparseScaledPowerExp22 zBits trace) *
          (2 : ℝ) ^ (-sparseScaledPowerExp22 zBits trace) :=
        mul_le_mul_of_nonneg_right h (zpow_nonneg (by norm_num) _)
    _ = ((zNum : ℝ) / 2 ^ zBits) ^ (sparseScaledPowerDeg22 trace) := by
        rw [mul_assoc, ← zpow_add₀ two_ne, add_neg_cancel, zpow_zero, mul_one]

